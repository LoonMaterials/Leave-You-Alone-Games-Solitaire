{
  "name": "leave-me-alone-games",
  "version": "1.0.0",
  "description": "A quiet, offline game collection built with plain HTML, CSS, and JavaScript.",
  "main": "index.html",
  "scripts": {
    "postinstall": "node scripts/build-www.js",
    "build": "node scripts/build-www.js",
    "test:games": "node scripts/test-new-games.js",
    "prepare:web": "node scripts/build-www.js",
    "prepare:ios": "npm run prepare:web",
    "prepare:android": "npm run prepare:web",
    "clean:ios-web": "node scripts/clean-ios-public.js",
    "sync": "npm run prepare:web && npx cap sync",
    "sync:ios": "npm run prepare:ios && npm run clean:ios-web && npx cap sync ios",
    "open:ios": "npm run sync:ios && npx cap open ios",
    "sync:android": "npm run prepare:android && npx cap sync android",
    "open:android": "npm run sync:android && npx cap open android",
    "ios:sync": "npm run sync:ios",
    "ios:open": "npm run open:ios",
    "android:sync": "npm run sync:android",
    "android:open": "npm run open:android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoonMaterials/Leave-Me-Alone-Games.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LoonMaterials/Leave-Me-Alone-Games/issues"
  },
  "homepage": "https://github.com/LoonMaterials/Leave-Me-Alone-Games#readme",
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0"
  }
}
